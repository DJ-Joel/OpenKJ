FROM fedora:44

RUN dnf upgrade -y && \
    dnf install -y \
    cmake \
    ninja-build \
    git \
    qt6-qtbase-devel \
    qt6-qtsvg-devel \
    gstreamer1-devel \
    gstreamer1-plugins-base-devel \
    spdlog-devel \
    taglib-devel \
    && dnf clean all

COPY ./ /openkj/
WORKDIR /openkj/
RUN cmake . -B build -G Ninja
RUN ninja -C build

